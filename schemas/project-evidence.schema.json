{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-documentation-builder/project-evidence.schema.json",
  "title": "Project Documentation Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "source_version", "facts", "components", "workflows", "open_questions", "analysis_limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_type", "scope", "audiences"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["github_repository", "local_repository", "source_archive", "low_code_export", "description", "hybrid"]},
        "scope": {"type": "string", "minLength": 1},
        "included_systems": {"type": "array", "items": {"type": "string"}, "default": []},
        "excluded_systems": {"type": "array", "items": {"type": "string"}, "default": []},
        "audiences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "maturity": {"enum": ["experimental", "testing", "production", "deprecated", "unknown"]}
      }
    },
    "source_version": {"$ref": "#/$defs/sourceVersion"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "components": {"type": "array", "items": {"$ref": "component.schema.json"}},
    "workflows": {"type": "array", "items": {"$ref": "workflow.schema.json"}},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/openQuestion"}},
    "analysis_limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "verificationState": {"enum": ["confirmed", "inferred", "unknown", "conflict"]},
    "implementationState": {"enum": ["current", "intended", "planned", "deprecated", "unknown"]},
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "locator", "ref", "revision", "environment", "analyzed_at"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "analyzed_at": {"type": "string", "format": "date-time"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "location", "version"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "lines": {"type": "string"},
        "artifact_id": {"type": "string"},
        "environment": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "claim", "verification_state", "implementation_state", "confidence", "sources", "used_in"],
      "properties": {
        "id": {"type": "string", "pattern": "^FACT-[A-Z0-9_-]+$"},
        "category": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "verification_state": {"$ref": "#/$defs/verificationState"},
        "implementation_state": {"$ref": "#/$defs/implementationState"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "rationale": {"type": "string"},
        "conflict_details": {"type": "string"},
        "used_in": {"type": "array", "items": {"type": "string"}}
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "why_it_matters", "status", "related_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^Q-[A-Z0-9_-]+$"},
        "question": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "proposed_assumption": {"type": "string"},
        "status": {"enum": ["open", "answered", "deferred", "not_applicable"]},
        "related_ids": {"type": "array", "items": {"type": "string"}},
        "answer": {"type": "string"},
        "answer_sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
